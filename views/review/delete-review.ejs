<% if (title) { %>
  <h1><%= title %></h1>
<% } %>

<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
  <% errors.array().forEach(error => { %>
    <li><%= error.msg %></li>
  <% }) %>
  </ul>
<% } %>

<div id="delete-review-container">
    <p>Review Date: <%= new Date(review_date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %></p>
    <p class="notice">Are you sure you want to delete this review? This action cannot be undone.</p>
    
    <div class="review-preview">
        <strong>Review Text:</strong>
        <p><%= review_text %></p>
    </div>

    <form action="/review/delete" method="post">
        <input type="hidden" name="review_id" value="<%= review_id %>">
        <button type="submit">Confirm Delete</button>
    </form>
</div>
